====
---- QUERY
insert into test values (6, 'f', 90), (6, 'ff', 91);
set streaming_predicate_delete_threshold=0;
update test set comm='first' where i=6;
update test set comm=null, count=count+1 where i=6;
select count(*) from test_dels where _assignment_exprs is not null;
---- RESULTS
2
---- TYPES
BIGINT
====
---- QUERY
select i, comm, count from test where i=6 order by comm, count;
---- RESULTS
6,'NULL',91
6,'NULL',92
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
migrate test;
select i, comm, count from test where i=6 order by comm, count;
---- RESULTS
6,'NULL',91
6,'NULL',92
---- TYPES
INT, STRING, BIGINT
