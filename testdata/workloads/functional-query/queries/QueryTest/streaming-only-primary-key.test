====
---- QUERY
create table test (i int primary key, d int) stored as streaming;
upsert into test values (1, 100), (2, 200);
select * from test order by i;
---- RESULTS
1,100
2,200
---- TYPES
INT,INT
====
---- QUERY
migrate test;
select * from test order by i;
---- RESULTS
1,100
2,200
---- TYPES
INT,INT
====
---- QUERY
upsert into test values (2, 201);
delete from test where i=2;
migrate test;
select * from test order by i;
---- RESULTS
1,100
---- TYPES
INT,INT
====
