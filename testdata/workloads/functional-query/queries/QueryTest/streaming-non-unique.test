====
---- QUERY
create table test (i int non unique primary key, comm string, count bigint) stored as streaming;
====
---- QUERY
insert into test values (1, 'a', 10), (2, 'b', 20),
    (3, 'c', 30), (4, 'd', 40), (5, 'e', 50);
delete from test where i=2;
insert into test values (2, 'b', 20);
select * from test order by i;
---- RESULTS
1,'a',10
2,'b',20
3,'c',30
4,'d',40
5,'e',50
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
# Migrate Kudu to Iceberg.
migrate test;
select * from test order by i;
---- RESULTS
1,'a',10
2,'b',20
3,'c',30
4,'d',40
5,'e',50
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
# Add new and modify existing data after migrate.
insert into test values (6, 'f', null), (7, 'g', 70);
insert into test select 1, 'aa', count from test where i=1;
select * from test order by i, comm;
---- RESULTS
1,'a',10
1,'aa',10
2,'b',20
3,'c',30
4,'d',40
5,'e',50
6,'f',NULL
7,'g',70
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
delete from test where i=1;
delete from test where i=3;
insert into test values (6, 'ff', 61);
insert into test values (8,'h',80);
select * from test order by i, count;
---- RESULTS
2,'b',20
4,'d',40
5,'e',50
6,'ff',61
6,'f',NULL
7,'g',70
8,'h',80
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
migrate test;
select * from test order by i, count;
---- RESULTS
2,'b',20
4,'d',40
5,'e',50
6,'ff',61
6,'f',NULL
7,'g',70
8,'h',80
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
update test set comm='oops' where i>=5 and i<8;
insert into test values (8,'h',81);
select * from test order by i, count;
---- RESULTS
2,'b',20
4,'d',40
5,'oops',50
6,'oops',61
6,'oops',NULL
7,'oops',70
8,'h',80
8,'h',81
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
set direct_kudu_update=true;
update test set comm='bb' where i=2;
update test set comm='direct', count=count+1 where i>=7;
delete test where i=2;
delete test where i=6;
select * from test order by i, count;
---- RESULTS
2,'b',20
4,'d',40
5,'oops',50
7,'direct',71
8,'h',80
8,'direct',82
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
insert into test values (2, 'bb', 21);
delete test where count % 10 = 1;
select * from test order by i, count;
---- RESULTS
2,'b',20
4,'d',40
5,'oops',50
8,'h',80
8,'direct',82
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
insert into test values (1, 'a', 12);
select sleep(3000);
insert into test values (2, 'b', 22);
migrate test as of now() - interval 2 seconds;
select * from test order by i, count;
---- RESULTS
1,'a',12
2,'b',20
2,'b',22
4,'d',40
5,'oops',50
8,'h',80
8,'direct',82
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
select sleep(5000);
select * from test order by i, count;
---- RESULTS
1,'a',12
2,'b',20
2,'b',22
4,'d',40
5,'oops',50
8,'h',80
8,'direct',82
---- TYPES
INT, STRING, BIGINT
