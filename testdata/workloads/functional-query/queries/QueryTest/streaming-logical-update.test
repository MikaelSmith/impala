2,'b',20
3,'c',30
4,'cc',40
5,'e',50
6,'f',60
7,'g',15
---- TYPES
INT, STRING, BIGINT
====
---- QUERY
set streaming_predicate_delete_threshold=0;
update test set comm='first' where i=4;
update test set comm=null, count=count+1 where i=4;
select count(*) from test_dels where _assignment_exprs is not null;
---- RESULTS
2
---- TYPES
BIGINT
====
---- QUERY
select * from test where i=4;
---- RESULTS
4,'NULL',41
---- TYPES
INT, STRING, BIGINT
